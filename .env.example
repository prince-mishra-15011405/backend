# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/india_airfare_index

# Scraper Scheduler Configuration
SCRAPER_ENABLED=true
SCRAPE_CRON=*/45 * * * *

# Puppeteer Configuration
PUPPETEER_HEADLESS=true
PUPPETEER_TIMEOUT=45000

# Cache & Freshness Configuration
SEARCH_DATA_MAX_AGE_MINUTES=60
SEARCH_SCRAPE_ENABLED=true
CACHE_TTL_MS=60000
